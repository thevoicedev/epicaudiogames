# Git stores text with LF line endings. These files keep theirs on every checkout, Windows included.
* text=auto
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.ttf binary
*.otf binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.m4v binary
*.m4a binary
*.mp3 binary
*.opus binary
*.wav binary
*.zip binary
*.caf binary
*.sh text eol=lf
*.pbxproj text eol=lf
fixtures/engine/** linguist-generated=true
