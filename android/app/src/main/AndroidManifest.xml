<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Answers can be spoken; the games also work by typing and with the answer buttons, so a device with no
         microphone (or a screen that doesn't turn to portrait) can still play them. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <!-- Everything works with a keyboard and mouse too (DESIGN.md: keyboard shortcuts and focus), so Play shouldn't
         hide the app from Chromebooks without a touchscreen. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- A game goes on with the screen off or the phone in a pocket: a foreground service plays its voice and listens
         (the microphone type only once the mic is allowed), with a notification (Android 13+ asks for it with the
         mic; the service runs either way), and keeps the CPU up while the game talks or listens. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A Bluetooth headset's mic, while the game listens (its call link, asked for as the communication device). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- A tick as the microphone opens and closes, with the listening sounds (Settings: Vibrate when listening
         starts), and when a pack installs. Granted with the app; nothing is asked. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Packs are downloaded from the pack server, and usage data goes to ours (while Share usage data is on). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Usage data that couldn't go for want of a network goes as it comes back (analytics/Analytics.kt). Granted
         with the app; nothing is asked. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+: lets the app find the device's speech recogniser. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Backups (Google's, and a new phone set up from an old one) carry the games' places and the settings, and
         nothing else: res/xml/backup_rules.xml (Android 6 to 11) and data_extraction_rules.xml (12 and later) say
         why. The usage data's random ID and queue, and the packs, are in no_backup, which is never backed up. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EpicAudioGames"
        tools:targetApi="31">
        <!-- Phones stay portrait, and large screens turn any way: MainActivity.onCreate says which, by the screen's
             smallest width (docs/DESIGN.md, Tablets). It starts with the system's splash (navy, the emblem), then
             has the app's own theme. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EpicAudioGames.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".GameService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />
        <!-- The Wear OS app's buttons (WearBridge.kt): Google Play services hands the watch's messages to it, and starts
             the app for them if it isn't running (it then tells the watch no game is open). Exported for Play services,
             the only caller it takes. -->
        <service
            android:name=".WearCommands"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/game-command"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
