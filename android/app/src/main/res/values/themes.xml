<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Navy behind the app until its first frame (as the splash is); the screens and the bars' icons take their
         colours from the theme the player picked (ui/theme/EpicTheme.kt). -->
    <style name="Theme.EpicAudioGames" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
    </style>

    <!-- The system's splash as the app starts (docs/DESIGN.md, Intro), on Android 7 to 11 too (core-splashscreen):
         navy, with the emblem in the middle. drawable-*/splash_emblem is made for it by tools/make_art.py (a 288 dp
         canvas, the emblem 128 dp across inside the 192 dp circle the splash shows), so the intro screen
         (ui/IntroScreen.kt) draws it again at the same size, in the same place. MainActivity's installSplashScreen()
         then puts the app's own theme back. -->
    <style name="Theme.EpicAudioGames.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.EpicAudioGames</item>
    </style>
</resources>
