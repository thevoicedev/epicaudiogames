<?xml version="1.0" encoding="utf-8"?>
<!-- What the phone app can do on Wear OS's network: the Wear OS app (android/wear) sends its buttons to the phone that
     has it (WearLink.PHONE_CAPABILITY). Only Play services reads it, so the resource shrinker is told to keep it. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@array/android_wear_capabilities">
    <string-array name="android_wear_capabilities" translatable="false">
        <item>epic_audio_games_phone</item>
    </string-array>
</resources>
