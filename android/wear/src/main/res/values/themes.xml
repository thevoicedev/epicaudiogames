<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The watch app's window: the navy the screen is drawn on (WatchScreen.kt), so it starts the colour it will be.
         Android 12+ (every watch it runs on) shows its own splash first, the app's icon on that navy. -->
    <style name="Theme.EpicWatch" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
    </style>
</resources>
