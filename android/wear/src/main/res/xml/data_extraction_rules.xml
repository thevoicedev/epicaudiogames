<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the watch app keeps nothing (the game's state is the phone's, read again as the app opens), so
     there's nothing to back up or carry to a new watch. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>