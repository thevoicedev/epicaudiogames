// The Apple Watch app's target (EpicWatch) only, as App.xcconfig is the iPhone app's: the project's Debug.xcconfig and
// Release.xcconfig (with Base.xcconfig) come first, then this. docs/WATCH.md says how the target is added on the Mac,
// and which of the template's own settings to delete so that these hold. A build setting file, not a resource: its
// Target Membership box stays unticked.

// watchOS 10 and later, Apple Watch only (Base.xcconfig's platform is the iPhone's).
SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
WATCHOS_DEPLOYMENT_TARGET = 10.0

// Swift 6 (Base.xcconfig) and, as in the iPhone app's target, code main-actor isolated unless it says otherwise:
// WatchConnectivity's callbacks come on its own queue, to a nonisolated delegate that hops to the main actor itself
// (PhoneLink.swift).
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// The iPhone app's companion (Base.xcconfig's EPIC_BUNDLE_ID): it comes with the iPhone app, never on its own. Its
// version and build are the iPhone app's (Base.xcconfig; fastlane's beta lane gives every target the same build), as
// the App Store requires.
PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(EPIC_BUNDLE_ID).watchkitapp
INFOPLIST_KEY_CFBundleDisplayName = Epic Audio Games
INFOPLIST_KEY_WKCompanionAppBundleIdentifier = $(EPIC_BUNDLE_ID)
INFOPLIST_KEY_WKRunsIndependentlyOfCompanionApp = NO
// Either wrist, either way up (the watch's own setting).
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// Embedded in the iPhone app (its Embed Watch Content phase): an archive doesn't install it on its own.
SKIP_INSTALL = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_PREVIEWS = YES

// Assets.xcassets: the iPhone app's icon (one 1024 image, which watchOS rounds), and its gold.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
