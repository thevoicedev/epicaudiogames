// The app target only (the test targets don't use it): android/app's manifest and theme, as Info.plist keys.

// Code is main-actor isolated unless it says otherwise. AVAudioEngine, AVAudioSession and SFSpeech callbacks
// run on other threads: they live in nonisolated types and hop to the main actor themselves.
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

PRODUCT_NAME = $(TARGET_NAME)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_PREVIEWS = YES

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
// Colour sets are reached as ColorResource (Color(.launchBackground)), without Color extensions that could
// clash with the app's own colour names (UI/Design/Tokens.swift).
ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO

// Info.plist: these keys are generated; Config/Info.plist has the dictionaries and arrays (it is outside the
// EpicAudioGames folder, so it isn't copied into the app as a resource).
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_PREPROCESS = YES
INFOPLIST_KEY_CFBundleDisplayName = Epic Audio Games
INFOPLIST_KEY_NSMicrophoneUsageDescription = When it's your turn, the game listens so you can say your answer out loud, also with your iPhone locked while a game is open. You can always tap or type instead.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Speech recognition turns what you say into words the game understands. Where your iPhone supports it, this happens on the device itself.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
// iPhones portrait only, as Android's phones. An iPad turns any way and takes any window size (Split View, Stage
// Manager): Config/Info.plist's UISupportedInterfaceOrientations~ipad has all four, and there's no
// UIRequiresFullScreen. Light or dark as the player's theme says (UI/Design/EpicTheme.swift sets the window's), and
// the status bar's icons with it (light over the navy launch screen and intro: Config/Info.plist's UIStatusBarStyle).
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

// iPhone and iPad (docs/DESIGN.md, "Tablets, foldables, Chromebooks, Mac and Vision"): Base.xcconfig's iPhone only is
// for the other targets. The iPad app runs as it is on Apple-silicon Macs and on Apple Vision Pro ("Designed for iPad").
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = YES
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = YES
